{
  "schemaVersion": 1,
  "id": "pvp-dimensions-justfatlard",
  "version": "${version}",
  "name": "PvP Dimensions",
  "description": "Arenas on demand, each fight in a dimension of its own",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/pvp-dimensions"
  },
  "license": "MIT",
  "icon": "assets/pvp-dimensions-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.pvp_dimensions.PvpDimensions"
    ]
  },
  "mixins": [
    "pvp-dimensions-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=15.35.0"
  },
  "suggests": {
    "pinata": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
    }
  }
}
